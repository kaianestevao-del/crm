generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum SessionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  UNKNOWN
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Bring-your-own-key: used by the worker to transcribe audio messages via Groq's
  // Whisper-compatible endpoint. Null/empty disables transcription for the org.
  groqApiKey String?

  // Autoatendimento: NOT an auto-reply — a keyword found in an inbound message links that
  // contact to one or more existing Abas (Tags), e.g. to record which ad/story/bio link a
  // lead came in from. See AutoTagRule below. Never sends anything to the customer.
  autoTaggingEnabled Boolean @default(false)

  memberships      Membership[]
  whatsappSessions WhatsappSession[]
  contacts         Contact[]
  conversations    Conversation[]
  autoTagRules     AutoTagRule[]
  pipelines        Pipeline[]
  deals            Deal[]
  notes            Note[]
  quickReplyCategories QuickReplyCategory[]
  quickReplies     QuickReply[]
  tags             Tag[]
  scheduledMessages ScheduledMessage[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Appended to outgoing WhatsApp messages so customers on a shared number know who's
  // writing. Defaults to `name` when signatureName is unset.
  signatureEnabled Boolean @default(true)
  signatureName    String?

  memberships          Membership[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  assignedDeals        Deal[]         @relation("AssignedAgent")
  sentMessages         Message[]      @relation("SentBy")
  scheduledMessages    ScheduledMessage[]
}

model Membership {
  id             String   @id @default(cuid())
  role           Role     @default(AGENT)
  createdAt      DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model WhatsappSession {
  id          String        @id @default(cuid())
  name        String
  phoneNumber String?
  status      SessionStatus @default(PENDING)
  qrCode      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  whatsappLabels WhatsappLabel[]

  @@index([organizationId])
}

model Contact {
  id          String   @id @default(cuid())
  waJid       String
  name        String?
  phoneNumber String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  deals          Deal[]
  notes          Note[]
  tags           ContactTag[]
  whatsappLabels ContactWhatsappLabel[]

  @@unique([organizationId, waJid])
  @@index([organizationId])
}

// Loose, multi-valued tags scoped to our own CRM (the "Abas" from the feature-parity
// research) — independent from the Kanban pipeline stage, and independent from
// WhatsappLabel below (which mirrors WhatsApp's own native labels).
model Tag {
  id    String  @id @default(cuid())
  name  String
  color String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts ContactTag[]
  autoTagRules AutoTagRuleTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

// Mirrors WhatsApp's own native Business labels (read from and written back to WhatsApp
// itself via Baileys), kept separate from Tag so a CRM-only tag is never confused with
// one that actually exists inside WhatsApp.
model WhatsappLabel {
  id        String  @id @default(cuid())
  waLabelId String
  name      String
  color     Int?
  deleted   Boolean @default(false)

  whatsappSessionId String
  whatsappSession   WhatsappSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  contacts ContactWhatsappLabel[]

  @@unique([whatsappSessionId, waLabelId])
  @@index([whatsappSessionId])
}

model ContactWhatsappLabel {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  labelId   String
  label     WhatsappLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

enum QuickReplyType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
}

model QuickReplyCategory {
  id       String  @id @default(cuid())
  name     String
  hexColor String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quickReplies QuickReply[]

  @@index([organizationId])
}

model QuickReply {
  id        String         @id @default(cuid())
  title     String
  type      QuickReplyType @default(TEXT)
  content   String?
  mediaUrl  String?
  mediaName String?
  createdAt DateTime       @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   QuickReplyCategory? @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
}

model Conversation {
  id            String              @id @default(cuid())
  lastMessageAt DateTime            @default(now())
  unreadCount   Int                 @default(0)
  status        ConversationStatus  @default(OPEN)
  createdAt     DateTime            @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  whatsappSessionId String
  whatsappSession   WhatsappSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation("AssignedAgent", fields: [assignedUserId], references: [id])

  messages Message[]
  scheduledMessages ScheduledMessage[]

  @@unique([whatsappSessionId, contactId])
  @@index([organizationId])
}

model ScheduledMessage {
  id           String                 @id @default(cuid())
  content      String
  scheduledFor DateTime
  status       ScheduledMessageStatus @default(PENDING)
  sentMessageId String?
  error        String?
  createdAt    DateTime               @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User? @relation(fields: [createdByUserId], references: [id])

  @@index([conversationId])
  @@index([organizationId])
}

// A keyword-triggered autoatendimento rule: when an inbound message contains any of
// `keywords` (case-insensitive, accent-folded), the linked Tags (Abas) below are attached to
// that contact — e.g. to record which ad, story, or bio link a lead came in from. Rules are
// checked in `order` and the first match wins. This never sends anything back to the contact.
model AutoTagRule {
  id        String   @id @default(cuid())
  keywords  String[]
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tags AutoTagRuleTag[]

  @@index([organizationId])
}

model AutoTagRuleTag {
  ruleId String
  rule   AutoTagRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleId, tagId])
  @@index([tagId])
}

model Message {
  id            String            @id @default(cuid())
  direction     MessageDirection
  type          MessageType       @default(TEXT)
  content       String?
  mediaUrl      String?
  waMessageId   String?
  status        MessageStatus     @default(PENDING)
  createdAt     DateTime          @default(now())

  // Set when WhatsApp reports this message was deleted (revoked) by whoever sent it.
  // `content`/`mediaUrl` are deliberately left untouched — we already have our own copy
  // from the moment the message first came in, and we keep showing it to the attendant.
  revokedAt DateTime?

  // Speech-to-text transcript for AUDIO messages (filled in asynchronously by the worker).
  transcript String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sentByUserId String?
  sentByUser   User?   @relation("SentBy", fields: [sentByUserId], references: [id])

  @@unique([conversationId, waMessageId])
  @@index([conversationId])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages PipelineStage[]
  deals  Deal[]

  @@index([organizationId])
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String
  order Int
  color String?

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals Deal[]

  @@index([pipelineId])
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  value     Float?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation("AssignedAgent", fields: [assignedUserId], references: [id])

  @@index([organizationId])
  @@index([stageId])
}

