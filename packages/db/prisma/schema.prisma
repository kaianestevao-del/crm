generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum SessionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  CONTACT
  LOCATION
  UNKNOWN
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum TemplateCategory {
  MARKETING
  UTILITY
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum CampaignAudienceType {
  TAG
  LABEL
  ALL
  CONTACTS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Bring-your-own-key: used by the worker to transcribe audio messages via Groq's
  // Whisper-compatible endpoint. Null/empty disables transcription for the org.
  groqApiKey String?

  // Dashboard: how many follow-up messages count as "completing" the follow-up sequence for
  // a lead — shown as "X de N" on deals sitting in a FOLLOW_UP-role stage.
  followUpMessageTarget Int @default(13)

  // Autoatendimento: NOT an auto-reply — a keyword found in an inbound message links that
  // contact to one or more existing Abas (Tags), e.g. to record which ad/story/bio link a
  // lead came in from. See AutoTagRule below. Never sends anything to the customer.
  autoTaggingEnabled Boolean @default(false)

  // Estimated price per delivered template message, by category — the Meta Cloud API has no
  // "spend so far" endpoint, so Campaigns estimate cost as recipientCount × this value. Edited
  // by the org owner on the Campaigns page as Meta's actual billed rate changes.
  templatePriceMarketing Decimal @default(0.35)
  templatePriceUtility   Decimal @default(0.04)

  memberships      Membership[]
  whatsappSessions WhatsappSession[]
  contacts         Contact[]
  conversations    Conversation[]
  autoTagRules     AutoTagRule[]
  pipelines        Pipeline[]
  deals            Deal[]
  notes            Note[]
  quickReplyCategories QuickReplyCategory[]
  quickReplies     QuickReply[]
  tags             Tag[]
  scheduledMessages ScheduledMessage[]
  messageTemplates MessageTemplate[]
  campaigns        Campaign[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Appended to outgoing WhatsApp messages so customers on a shared number know who's
  // writing. Defaults to `name` when signatureName is unset.
  signatureEnabled Boolean @default(true)
  signatureName    String?

  memberships          Membership[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  assignedDeals        Deal[]         @relation("AssignedAgent")
  sentMessages         Message[]      @relation("SentBy")
  scheduledMessages    ScheduledMessage[]
}

model Membership {
  id             String   @id @default(cuid())
  role           Role     @default(AGENT)
  createdAt      DateTime @default(now())

  // Only meaningful for AGENT — OWNER/ADMIN always have full access regardless of this list.
  // One flat on/off switch per module key (see MODULE_KEYS in @crm/shared), no separate
  // view/edit distinction.
  allowedModules String[] @default([])

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum WhatsappProvider {
  // Unofficial protocol via Baileys — QR Code or phone-number pairing, no message-sending
  // restrictions, but breaks for numbers already registered on Meta's official Cloud API.
  BAILEYS
  // Official Meta WhatsApp Business Platform — no QR Code, receives via webhook, sends via
  // the Graph API. Required for numbers that have ever been onboarded to the Cloud API.
  CLOUD_API
}

model WhatsappSession {
  id          String           @id @default(cuid())
  name        String
  phoneNumber String?
  status      SessionStatus    @default(PENDING)
  qrCode      String?
  // 8-character code for WhatsApp's "link with phone number" pairing flow — an alternative to
  // scanning the QR code, meant for a team member connecting a number remotely.
  pairingCode String?
  provider    WhatsappProvider @default(BAILEYS)

  // Cloud API credentials — only set when provider = CLOUD_API. Never returned raw by the API
  // once saved (only a hasX boolean), same convention as Organization.groqApiKey.
  cloudApiPhoneNumberId      String?
  cloudApiAccessToken        String?
  cloudApiAppSecret          String?
  cloudApiWebhookVerifyToken String?
  // WhatsApp Business Account id — a different id than the phone number itself. Message
  // Templates are managed at this level (create/list/approval-status), not per phone number,
  // so Campaigns/Templates need it in addition to cloudApiPhoneNumberId.
  cloudApiWabaId             String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Soft-delete: "removing" a connection (e.g. an employee's number leaving the team) must
  // never cascade-delete the Conversations/Messages that already went through it — that history
  // stays forever. Deleting just logs the session out and hides it from the active list.
  archivedAt DateTime?

  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  whatsappLabels WhatsappLabel[]
  messageTemplates MessageTemplate[]
  campaigns        Campaign[]

  @@index([organizationId])
}

model Contact {
  id          String   @id @default(cuid())
  waJid       String
  name        String?
  phoneNumber String
  avatarUrl   String?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  deals          Deal[]
  notes          Note[]
  tags           ContactTag[]
  whatsappLabels ContactWhatsappLabel[]
  campaignRecipients CampaignRecipient[]

  @@unique([organizationId, waJid])
  @@index([organizationId])
}

// Loose, multi-valued tags scoped to our own CRM (the "Abas" from the feature-parity
// research) — independent from the Kanban pipeline stage, and independent from
// WhatsappLabel below (which mirrors WhatsApp's own native labels).
model Tag {
  id    String  @id @default(cuid())
  name  String
  color String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts ContactTag[]
  autoTagRules AutoTagRuleTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

// Mirrors WhatsApp's own native Business labels (read from and written back to WhatsApp
// itself via Baileys), kept separate from Tag so a CRM-only tag is never confused with
// one that actually exists inside WhatsApp.
model WhatsappLabel {
  id        String  @id @default(cuid())
  waLabelId String
  name      String
  color     Int?
  deleted   Boolean @default(false)

  whatsappSessionId String
  whatsappSession   WhatsappSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  contacts ContactWhatsappLabel[]

  @@unique([whatsappSessionId, waLabelId])
  @@index([whatsappSessionId])
}

model ContactWhatsappLabel {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  labelId   String
  label     WhatsappLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

enum QuickReplyType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
}

model QuickReplyCategory {
  id       String  @id @default(cuid())
  name     String
  hexColor String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  quickReplies QuickReply[]

  @@index([organizationId])
}

model QuickReply {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   QuickReplyCategory? @relation(fields: [categoryId], references: [id])

  // Ordered parts sent as separate WhatsApp messages, one after another, when this quick
  // reply is triggered — e.g. a confirmation text, then a document, then a follow-up text.
  steps QuickReplyStep[]

  @@index([organizationId])
}

model QuickReplyStep {
  id           String         @id @default(cuid())
  quickReplyId String
  quickReply   QuickReply     @relation(fields: [quickReplyId], references: [id], onDelete: Cascade)
  order        Int
  type         QuickReplyType @default(TEXT)
  content      String?
  mediaUrl     String?
  mediaName    String?

  @@index([quickReplyId])
}

model Conversation {
  id            String              @id @default(cuid())
  lastMessageAt DateTime            @default(now())
  unreadCount   Int                 @default(0)
  status        ConversationStatus  @default(OPEN)
  createdAt     DateTime            @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  whatsappSessionId String
  whatsappSession   WhatsappSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation("AssignedAgent", fields: [assignedUserId], references: [id])

  messages Message[]
  scheduledMessages ScheduledMessage[]

  @@unique([whatsappSessionId, contactId])
  @@index([organizationId])
}

model ScheduledMessage {
  id           String                 @id @default(cuid())
  content      String
  scheduledFor DateTime
  status       ScheduledMessageStatus @default(PENDING)
  sentMessageId String?
  error        String?
  createdAt    DateTime               @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User? @relation(fields: [createdByUserId], references: [id])

  @@index([conversationId])
  @@index([organizationId])
}

// A single named "autoatendimento" (e.g. "Social Seller"): when an inbound message contains
// any of `keywords` (its trigger, case-insensitive and accent-folded), the linked Tags (Abas)
// below are attached to that contact (its action) — e.g. to record which ad, story, or bio
// link a lead came in from, and when. Checked in `order`, first match wins. Never sends
// anything back to the contact.
model AutoTagRule {
  id        String   @id @default(cuid())
  name      String
  keywords  String[]
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tags AutoTagRuleTag[]

  @@index([organizationId])
}

model AutoTagRuleTag {
  ruleId String
  rule   AutoTagRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleId, tagId])
  @@index([tagId])
}

model Message {
  id            String            @id @default(cuid())
  direction     MessageDirection
  type          MessageType       @default(TEXT)
  content       String?
  mediaUrl      String?
  waMessageId   String?
  status        MessageStatus     @default(PENDING)
  createdAt     DateTime          @default(now())

  // Set when WhatsApp reports this message was deleted (revoked) by whoever sent it.
  // `content`/`mediaUrl` are deliberately left untouched — we already have our own copy
  // from the moment the message first came in, and we keep showing it to the attendant.
  revokedAt DateTime?

  // Speech-to-text transcript for AUDIO messages (filled in asynchronously by the worker).
  transcript String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sentByUserId String?
  sentByUser   User?   @relation("SentBy", fields: [sentByUserId], references: [id])

  campaignRecipient CampaignRecipient?

  @@unique([conversationId, waMessageId])
  @@index([conversationId])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages PipelineStage[]
  deals  Deal[]

  @@index([organizationId])
}

// What a stage means for dashboard metrics, independent of its display name (which each org
// can set freely) — set by the org owner in Configurações, defaults to unset (null).
enum PipelineStageRole {
  FOLLOW_UP
  UNFOLLOW
  ACTIVE_PATIENT
  LOST_PATIENT
}

model PipelineStage {
  id    String             @id @default(cuid())
  name  String
  order Int
  color String?
  role  PipelineStageRole?

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals        Deal[]
  stageHistory DealStageHistory[]

  @@index([pipelineId])
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation("AssignedAgent", fields: [assignedUserId], references: [id])

  payments     DealPayment[]
  stageHistory DealStageHistory[]

  @@index([organizationId])
  @@index([stageId])
}

enum PaymentMethod {
  CREDIT_CARD
  PIX
}

// One row per value the patient has paid — a deal can have several over time
// (e.g. renews monthly), so the Kanban card and conversation show the running
// total plus each individual entry rather than a single overwritable value.
model DealPayment {
  id            String         @id @default(cuid())
  value         Float
  planType      String?
  paymentMethod PaymentMethod?
  paidAt        DateTime       @default(now())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// One row per continuous period a Deal spent in a given stage — powers the Dashboard's
// time-in-stage and follow-up metrics. exitedAt = null means "this is the deal's current
// stage" (at most one open row per deal at a time).
model DealStageHistory {
  id        String    @id @default(cuid())
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  followUpContacts DealFollowUpContact[]

  @@index([dealId])
  @@index([stageId])
  @@index([dealId, exitedAt])
}

// One manually-checked "contact made" box in the follow-up checklist ("3 de 13"). The agent
// marks these by hand from the conversation — nothing here is inferred from message traffic.
// Scoped to a single DealStageHistory period, so re-entering the Follow-up stage later starts
// a fresh checklist rather than carrying old marks over.
model DealFollowUpContact {
  id          String   @id @default(cuid())
  index       Int
  completedAt DateTime @default(now())

  dealStageHistoryId String
  dealStageHistory   DealStageHistory @relation(fields: [dealStageHistoryId], references: [id], onDelete: Cascade)

  @@unique([dealStageHistoryId, index])
  @@index([dealStageHistoryId])
}

// A WhatsApp Message Template, mirrored locally from what's submitted to the Meta Cloud API.
// Templates are the only way to send a business-initiated (proactive) message to a contact
// outside the 24h customer-service window — Meta reviews and approves/rejects each one before
// it can be used in a Campaign.
model MessageTemplate {
  id              String          @id @default(cuid())
  name            String          // Meta's format: lowercase + underscores only
  category        TemplateCategory
  language        String          @default("pt_BR")
  bodyText        String          // may contain {{1}}, {{2}}... (Meta's numbered placeholders)
  variableCount   Int             @default(0)
  // Meta requires a sample value per {{n}} placeholder to approve a template — without it,
  // submission is rejected with INVALID_FORMAT. Ordered to match {{1}}, {{2}}...
  bodyExamples    String[]        @default([])
  metaTemplateId  String?
  status          TemplateStatus  @default(DRAFT)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  whatsappSessionId String
  whatsappSession   WhatsappSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  @@index([organizationId])
  @@index([whatsappSessionId])
}

model Campaign {
  id            String         @id @default(cuid())
  name          String
  status        CampaignStatus @default(DRAFT)
  audienceType  CampaignAudienceType
  // Exactly one of these is set, matching audienceType; all empty/null for ALL.
  audienceTagId    String?
  audienceLabelId  String?
  audienceContactIds String[] @default([])
  // Locked in at send time (recipientCount × the org's price-per-message at that moment), so
  // editing the price table later doesn't retroactively change what a past campaign "cost".
  estimatedCost Decimal?
  createdAt     DateTime  @default(now())
  // Set only when the send was scheduled for later rather than fired immediately — the
  // campaign sits at status SCHEDULED until the delayed dispatch job fires (see
  // QUEUE_CAMPAIGN_DISPATCH), same "delayed BullMQ job, jobId = row id" pattern as
  // ScheduledMessage, so it can be cancelled the same way.
  scheduledFor  DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  whatsappSessionId String
  whatsappSession   WhatsappSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id])

  recipients CampaignRecipient[]

  @@index([organizationId])
}

model CampaignRecipient {
  id        String                   @id @default(cuid())
  status    CampaignRecipientStatus  @default(PENDING)
  error     String?
  createdAt DateTime                 @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Set once the send fires — Message.status (updated by the existing Cloud API status
  // webhook) is what actually tracks sent/delivered/read/failed from then on.
  messageId String? @unique
  message   Message? @relation(fields: [messageId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId])
}

