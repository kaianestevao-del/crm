DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_whatsapp?schema=public"
REDIS_URL="redis://localhost:6379"
SESSIONS_DIR="./sessions"
UPLOADS_DIR="../api/uploads"
PUBLIC_URL="http://localhost:4000"

# Backup diário (8h e 20h, horário de Brasília) — todos opcionais; cada canal de envio (e-mail,
# WhatsApp) é pulado sozinho se as próprias variáveis dele não estiverem preenchidas.
# Gmail: host smtp.gmail.com, porta 465, SMTP_USER é o e-mail, SMTP_PASS é uma "senha de app"
# (Conta Google > Segurança > Senhas de app — exige verificação em duas etapas ativada).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
BACKUP_EMAIL_TO=""
BACKUP_WHATSAPP_NUMBER=""
