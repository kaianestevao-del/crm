DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_whatsapp?schema=public"
REDIS_URL="redis://localhost:6379"
SESSIONS_DIR="./sessions"
UPLOADS_DIR="../api/uploads"
PUBLIC_URL="http://localhost:4000"

# Backup diário (8h e 20h, horário de Brasília) — todos opcionais; cada canal de envio (e-mail,
# WhatsApp) é pulado sozinho se as próprias variáveis dele não estiverem preenchidas.
# E-mail via Resend (resend.com) — não usa SMTP porque a Railway bloqueia saída SMTP.
# RESEND_API_KEY vem do painel do Resend; RESEND_FROM pode ficar em branco pra usar o domínio
# de teste deles (onboarding@resend.dev) ou apontar pra um domínio seu já verificado no Resend.
RESEND_API_KEY=""
RESEND_FROM=""
BACKUP_EMAIL_TO=""
# DDI+DDD+número, só dígitos — exige um Template de mensagem aprovado pela Meta pra números que
# nunca conversaram com a conta comercial antes (ver comentário em daily-backup-worker.ts).
BACKUP_WHATSAPP_NUMBER=""
