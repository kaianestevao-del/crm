{
  "name": "crm-whatsapp",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @crm/api dev",
    "dev:worker": "pnpm --filter @crm/worker dev",
    "dev:web": "pnpm --filter @crm/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @crm/db prisma:generate",
    "db:migrate": "pnpm --filter @crm/db prisma:migrate",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  }
}
